---
import fs from "fs";
import path from "path";
import Landing from "../components/Landing";
import "../styles/landing.css";

const iconsPath = path.join(process.cwd(), "icons.json");
const iconsData = JSON.parse(fs.readFileSync(iconsPath, "utf-8")) as Record<string, string>;

const iconNames = [
  ...new Set(
    Object.keys(iconsData)
      .map((name) => name.replace(/-(dark|light)$/i, ""))
      .map((name) => name.toLowerCase()),
  ),
].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ren0va</title>
    <meta
      name="description"
      content="Generate minimal icon grids via URL params. Pick icons, theme, and density — then share the link."
    />
  </head>
  <body>
    <Landing client:load iconNames={iconNames} />
  </body>
</html>

