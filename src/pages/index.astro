---
import fs from "fs";
import path from "path";
import "../styles/landing.css";

const iconsPath = path.join(process.cwd(), "icons.json");
const iconsData = JSON.parse(fs.readFileSync(iconsPath, "utf-8")) as Record<string, string>;

const iconNames = [
  ...new Set(
    Object.keys(iconsData)
      .map((name) => name.replace(/-(dark|light)$/i, ""))
      .map((name) => name.toLowerCase()),
  ),
].sort();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ren0va</title>
    <link rel="icon" type="image/png" href="/renova-logo.png?v=1" sizes="32x32" />
    <link rel="icon" type="image/png" href="/renova-logo.png?v=1" sizes="any" />
    <link rel="apple-touch-icon" href="/renova-logo.png?v=1" />
    <meta
      name="description"
      content="Generate minimal icon grids via URL params. Pick icons, theme, and density — then share the link."
    />
  </head>
  <body>
    <main class="landing">
      <header class="topbar">
        <div class="brand">
          <div class="brandText">
            <div class="brandTitleRow" aria-label="ren0va">
              <h1 class="brandTitle">ren0va</h1>
              <svg class="brandMarking" viewBox="0 0 320 64" preserveAspectRatio="none" aria-hidden="true">
                <path
                  class="markStroke markStroke1"
                  d="M8 46 C 66 28, 132 54, 192 40 S 268 30, 312 36"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="10"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  pathLength="1"
                />
                <path
                  class="markStroke markStroke2"
                  d="M12 54 C 74 36, 138 60, 204 46 S 276 38, 316 44"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  pathLength="1"
                />
              </svg>
            </div>
          </div>
        </div>

        <nav class="topActions" aria-label="Links">
          <a class="iconLink" href="https://github.com/dexisback/ren0va#readme" aria-label="Docs" data-tooltip="Documentation" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M7 4.5h9a2 2 0 0 1 2 2V20a1 1 0 0 1-1.447.894L12 18.5l-4.553 2.394A1 1 0 0 1 6 20V6.5a2 2 0 0 1 1-2Z"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linejoin="round"
              />
              <path d="M9 8.5h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
              <path d="M9 11.5h6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
            </svg>
          </a>
          <a class="iconLink" href="https://github.com/dexisback/ren0va" aria-label="GitHub" data-tooltip="GitHub" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M12 2.6a9.4 9.4 0 0 0-2.97 18.32c.47.09.64-.2.64-.45v-1.64c-2.6.57-3.15-1.1-3.15-1.1-.43-1.08-1.06-1.37-1.06-1.37-.86-.57.06-.56.06-.56.95.07 1.45.98 1.45.98.85 1.45 2.23 1.03 2.78.79.09-.62.33-1.03.6-1.27-2.08-.24-4.27-1.04-4.27-4.63 0-1.02.37-1.86.98-2.52-.1-.24-.42-1.2.09-2.5 0 0 .8-.26 2.62.96a9.04 9.04 0 0 1 4.78 0c1.82-1.22 2.62-.96 2.62-.96.51 1.3.2 2.26.1 2.5.6.66.98 1.5.98 2.52 0 3.6-2.19 4.39-4.28 4.62.35.3.66.9.66 1.82v2.7c0 .25.16.55.64.45A9.4 9.4 0 0 0 12 2.6Z"
                fill="currentColor"
                opacity="0.92"
              />
            </svg>
          </a>
          <a class="iconLink" href="https://x.com/dextertwts" aria-label="Twitter" data-tooltip="X (Twitter)" target="_blank" rel="noreferrer">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path
                d="M18.8 7.2c.01.18.01.37.01.55 0 5.6-4.26 12.05-12.05 12.05-2.39 0-4.6-.7-6.46-1.9.33.04.66.05 1 .05 1.98 0 3.8-.67 5.25-1.8a4.24 4.24 0 0 1-3.96-2.95c.26.04.52.07.8.07.38 0 .77-.05 1.13-.15a4.23 4.23 0 0 1-3.39-4.15v-.06c.57.32 1.22.51 1.92.53a4.24 4.24 0 0 1-1.31-5.64 12.03 12.03 0 0 0 8.74 4.43 4.23 4.23 0 0 1 7.2-3.86 8.4 8.4 0 0 0 2.69-1.03 4.22 4.22 0 0 1-1.86 2.34 8.44 8.44 0 0 0 2.43-.66 9.08 9.08 0 0 1-2.12 2.2Z"
                fill="currentColor"
                opacity="0.92"
              />
            </svg>
          </a>
        </nav>
      </header>

      <section class="urlBar" aria-label="Share">
        <div id="urlField" class="urlField" aria-label="Generated URL">
          <input id="urlInput" class="urlInput" value="" placeholder="Select icons to generate a URL…" readonly aria-readonly="true" />
        </div>
        <button id="copyBtn" type="button" class="primaryBtn" disabled>Copy URL</button>
      </section>

      <section class="grid" aria-label="Generator">
        <div class="previewWrap">
          <div class="previewHeader">
            <div>
              <p class="sectionLabel">Preview</p>
              <p class="sectionTitle">Live sprite output</p>
            </div>
            <button id="clearBtn" type="button" class="ghostBtn" disabled>Clear</button>
          </div>

          <div class="previewFrame" role="img" aria-label="Icon sprite preview">
            <img id="previewImg" class="previewImage" src="" alt="" style="display:none" />
            <div id="previewEmpty" class="previewEmpty">
              <div class="previewEmptyTitle">Nothing to preview</div>
              <div class="previewEmptyHint">Pick a couple of icons on the right.</div>
            </div>
          </div>
        </div>

        <aside class="controls" aria-label="Controls">
          <div class="controlBlock">
            <div class="controlHeader">
              <div>
                <p class="sectionLabel">Icons</p>
                <p class="sectionTitle">Search & select</p>
              </div>
              <span class="kbd" aria-hidden="true">Ctrl K</span>
            </div>

            <div class="searchArea" id="searchArea">
              <label class="srOnly" for="searchInput">Search icons</label>
              <input id="searchInput" class="input" placeholder="Search icons (react, typescript…)" autocomplete="off" />
              <div id="dropdown" class="dropdown" role="listbox" aria-label="Search results" style="display:none"></div>
            </div>

            <div id="chipRow" class="chipRow" aria-label="Selected icon chips">
              <span class="muted">No icons selected.</span>
            </div>
          </div>

          <div class="controlBlock">
            <div class="controlHeader">
              <div>
                <p class="sectionLabel">Layout</p>
                <p class="sectionTitle">Grid settings</p>
              </div>
            </div>

            <div class="settingsGrid">
              <div class="setting">
                <p class="settingLabel">Icons per line</p>
                <div class="seg">
                  <button id="perDec" type="button" class="segBtn" aria-label="Decrease icons per line">−</button>
                  <div id="perValue" class="segValue" aria-label="Icons per line value">3</div>
                  <button id="perInc" type="button" class="segBtn" aria-label="Increase icons per line">+</button>
                </div>
              </div>
              <div class="setting">
                <p class="settingLabel">Theme</p>
                <div class="seg two">
                  <button id="themeDark" type="button" class="segBtn active" aria-pressed="true">Dark</button>
                  <button id="themeLight" type="button" class="segBtn" aria-pressed="false">Light</button>
                </div>
              </div>
            </div>
          </div>

          <div class="controlBlock">
            <div class="controlHeader">
              <div>
                <p class="sectionLabel">Custom</p>
                <p class="sectionTitle">Upload an SVG</p>
              </div>
            </div>

            <div class="uploadRow">
              <input id="fileInput" type="file" accept="image/svg+xml" class="srOnly" tabindex="-1" />
              <button id="chooseFile" type="button" class="secondaryBtn">Choose file</button>
              <div id="uploadStatus" class="status idle" aria-live="polite"></div>
            </div>
          </div>
        </aside>
      </section>

      <footer class="footer">
        <p class="footerText">
          Tip: press <span class="kbdInline">Ctrl K</span> to search icons fast.
        </p>
      </footer>
    </main>

    <script define:vars={{ iconNames }}>
      const ICONS = iconNames

      let selectedIcons = []
      let customIcons = []
      let theme = "dark"
      let perLine = 3
      let query = ""
      let highlightedIndex = 0
      let searchOpen = false
      let copyTimeout = null
      let uploadClearTimeout = null

      const el = {
        urlField: document.getElementById("urlField"),
        urlInput: document.getElementById("urlInput"),
        copyBtn: document.getElementById("copyBtn"),
        clearBtn: document.getElementById("clearBtn"),
        previewImg: document.getElementById("previewImg"),
        previewEmpty: document.getElementById("previewEmpty"),
        searchArea: document.getElementById("searchArea"),
        searchInput: document.getElementById("searchInput"),
        dropdown: document.getElementById("dropdown"),
        chipRow: document.getElementById("chipRow"),
        perDec: document.getElementById("perDec"),
        perInc: document.getElementById("perInc"),
        perValue: document.getElementById("perValue"),
        themeDark: document.getElementById("themeDark"),
        themeLight: document.getElementById("themeLight"),
        fileInput: document.getElementById("fileInput"),
        chooseFile: document.getElementById("chooseFile"),
        uploadStatus: document.getElementById("uploadStatus"),
      }

      function buildUrl() {
        const icons = [...selectedIcons, ...customIcons]
        if (icons.length === 0) return ""
        const url = new URL("/icons", window.location.origin)
        url.searchParams.set("i", icons.join(","))
        url.searchParams.set("theme", theme)
        url.searchParams.set("perline", String(perLine))
        return url.toString()
      }

      function setSearchOpen(next) {
        searchOpen = next
        el.dropdown.style.display = searchOpen ? "block" : "none"
        if (searchOpen) {
          renderDropdown()
        }
      }

      function getFilteredIcons() {
        const q = query.trim().toLowerCase()
        return q ? ICONS.filter((name) => name.includes(q)) : ICONS
      }

      function renderDropdown() {
        const filtered = getFilteredIcons()
        highlightedIndex = Math.min(highlightedIndex, Math.max(filtered.length - 1, 0))

        if (filtered.length === 0) {
          el.dropdown.innerHTML = '<div class="dropdownEmpty">No results.</div>'
          return
        }

        el.dropdown.innerHTML = filtered
          .map((name, idx) => {
            const active = idx === highlightedIndex ? "active" : ""
            const selected = selectedIcons.includes(name) ? "selected" : ""
            const hint = selected ? "Selected" : "Add"
            return `<button type="button" class="option ${active} ${selected}" data-icon="${name}" data-index="${idx}" role="option" aria-selected="${selected}">
              <span class="optionName">${name}</span>
              <span class="optionHint">${hint}</span>
            </button>`
          })
          .join("")
      }

      el.dropdown.addEventListener("mouseover", (e) => {
        const btn = e.target.closest("button.option")
        if (!btn) return
        const idx = Number(btn.dataset.index)
        if (idx !== highlightedIndex) {
          highlightedIndex = idx
          renderDropdown()
        }
      })

      el.dropdown.addEventListener("click", (e) => {
        const btn = e.target.closest("button.option")
        if (!btn) return
        e.preventDefault()
        e.stopPropagation()
        toggleIcon(btn.dataset.icon)
      })

      function renderChips() {
        if (selectedIcons.length === 0) {
          el.chipRow.innerHTML = '<span class="muted">No icons selected.</span>'
          return
        }

        const chips = selectedIcons
          .slice(0, 18)
          .map(
            (name) =>
              `<button type="button" class="chip" data-icon="${name}" aria-label="Remove ${name}">${name}<span class="chipX" aria-hidden="true">×</span></button>`
          )
          .join("")
        el.chipRow.innerHTML = chips
        el.chipRow.querySelectorAll("button.chip").forEach((btn) => {
          btn.addEventListener("click", () => toggleIcon(btn.dataset.icon))
        })
      }

      function updatePreview() {
        const url = buildUrl()
        const imgTag = url ? `<img src="${url}" />` : ""
        el.urlInput.value = imgTag
        el.copyBtn.disabled = !url
        el.urlField.classList.toggle("disabled", !url)
        el.clearBtn.disabled = selectedIcons.length === 0 && customIcons.length === 0

        if (!url) {
          el.previewImg.style.display = "none"
          el.previewImg.src = ""
          el.previewEmpty.style.display = "grid"
          return
        }

        el.previewEmpty.style.display = "none"
        el.previewImg.style.display = "block"
        el.previewImg.src = url
      }

      function toggleIcon(icon) {
        if (!icon) return
        if (selectedIcons.includes(icon)) {
          selectedIcons = selectedIcons.filter((v) => v !== icon)
        } else {
          selectedIcons.push(icon)
        }
        renderDropdown()
        renderChips()
        updatePreview()
      }

      function clearAll() {
        selectedIcons = []
        customIcons = []
        query = ""
        highlightedIndex = 0
        el.searchInput.value = ""
        setSearchOpen(false)
        el.uploadStatus.textContent = ""
        el.uploadStatus.className = "status idle"
        updatePreview()
        renderChips()
      }

      function stepPerLine(delta) {
        const next = Math.min(10, Math.max(1, perLine + delta))
        perLine = next
        el.perValue.textContent = String(perLine)
        updatePreview()
      }

      function setTheme(next) {
        theme = next === "light" ? "light" : "dark"
        el.themeDark.classList.toggle("active", theme === "dark")
        el.themeLight.classList.toggle("active", theme === "light")
        el.themeDark.setAttribute("aria-pressed", theme === "dark" ? "true" : "false")
        el.themeLight.setAttribute("aria-pressed", theme === "light" ? "true" : "false")
        updatePreview()
      }

      async function onCopy() {
        const url = buildUrl()
        if (!url) return
        const imgTag = `<img src="${url}" />`
        try {
          await navigator.clipboard.writeText(imgTag)
          el.copyBtn.textContent = "Copied"
          el.copyBtn.classList.add("btnOk")
          if (copyTimeout) window.clearTimeout(copyTimeout)
          copyTimeout = window.setTimeout(() => {
            el.copyBtn.textContent = "Copy URL"
            el.copyBtn.classList.remove("btnOk")
          }, 1800)
        } catch {}
      }

      async function handleUpload(file) {
        if (!file || file.type !== "image/svg+xml") {
          el.uploadStatus.textContent = "Only SVG files allowed."
          el.uploadStatus.className = "status error"
          return
        }

        el.uploadStatus.textContent = "Uploading…"
        el.uploadStatus.className = "status idle"
        const formData = new FormData()
        formData.append("file", file)

        try {
          const res = await fetch("/custom-icons/upload", { method: "POST", body: formData })
          if (!res.ok) {
            el.uploadStatus.textContent = `Upload failed (${res.status}).`
            el.uploadStatus.className = "status error"
            return
          }
          const data = await res.json()
          if (!data || !data.objectPath) {
            el.uploadStatus.textContent = "Bad upload response."
            el.uploadStatus.className = "status error"
            return
          }

          customIcons.push(`custom:${data.objectPath}`)
          el.uploadStatus.textContent = "Uploaded."
          el.uploadStatus.className = "status ok"
          updatePreview()

          if (uploadClearTimeout) window.clearTimeout(uploadClearTimeout)
          uploadClearTimeout = window.setTimeout(() => {
            if (el.uploadStatus.textContent === "Uploaded.") {
              el.uploadStatus.textContent = ""
              el.uploadStatus.className = "status idle"
            }
          }, 2400)
        } catch {
          el.uploadStatus.textContent = "Upload error."
          el.uploadStatus.className = "status error"
        }
      }

      el.searchInput.addEventListener("input", () => {
        query = el.searchInput.value
        highlightedIndex = 0
        setSearchOpen(true)
        renderDropdown()
      })

      el.searchInput.addEventListener("focus", () => setSearchOpen(true))

      el.searchInput.addEventListener("keydown", (event) => {
        const filtered = getFilteredIcons()
        if (event.key === "ArrowDown") {
          event.preventDefault()
          highlightedIndex = Math.min(highlightedIndex + 1, Math.max(filtered.length - 1, 0))
          renderDropdown()
        } else if (event.key === "ArrowUp") {
          event.preventDefault()
          highlightedIndex = Math.max(highlightedIndex - 1, 0)
          renderDropdown()
        } else if (event.key === "Enter" && filtered[highlightedIndex]) {
          event.preventDefault()
          toggleIcon(filtered[highlightedIndex])
        } else if (event.key === "Escape") {
          setSearchOpen(false)
        }
      })

      document.addEventListener("keydown", (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
          event.preventDefault()
          setSearchOpen(true)
          el.searchInput.focus()
          el.searchInput.select()
        } else if (event.key === "Escape") {
          setSearchOpen(false)
        }
      })

      document.addEventListener("pointerdown", (event) => {
        if (!searchOpen) return
        if (el.searchArea.contains(event.target)) return
        setSearchOpen(false)
      })

      el.copyBtn.addEventListener("click", onCopy)
      el.clearBtn.addEventListener("click", clearAll)
      el.perDec.addEventListener("click", () => stepPerLine(-1))
      el.perInc.addEventListener("click", () => stepPerLine(1))
      el.themeDark.addEventListener("click", () => setTheme("dark"))
      el.themeLight.addEventListener("click", () => setTheme("light"))
      el.chooseFile.addEventListener("click", () => el.fileInput.click())
      el.fileInput.addEventListener("change", (event) => {
        const file = event.target.files && event.target.files[0]
        if (file) handleUpload(file)
        event.target.value = ""
      })

      renderChips()
      updatePreview()
    </script>
  </body>
</html>
